{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": false
  },
  "include": [
    "../../src/host/js/knot.d.ts",
    "../../examples/extensions/**/*.js",
    "examples/*.js",
    "contract.test.ts"
  ]
}
