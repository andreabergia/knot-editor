{
  // Compiles every package's sources and tests with the fake host, mirroring
  // repository paths under .test-build.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": ".test-build",
    "types": ["node"],
    "paths": {
      "knot/testing": ["./testing/host.ts"],
      "knot/testing/languages": ["./testing/languages.ts"]
    }
  },
  "include": [
    "testing/*.ts",
    "../../extensions/*/*/src",
    "../../extensions/*/*/test",
    "../../examples/extensions/*/*/src",
    "../../examples/extensions/*/*/test"
  ],
  // Fixtures are inputs to tests, such as source files in other languages.
  "exclude": ["../../extensions/*/*/test/fixtures", "../../examples/extensions/*/*/test/fixtures"]
}
